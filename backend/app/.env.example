# 复制为 backend/app/.env 并填入真实值（.env 不要提交到 git）

# LLM 模型配置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
MODEL_NAME=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 如需走本地代理（Windows 示例），取消注释并按需修改
# OPENAI_PROXY=http://127.0.0.1:7897

# PostgreSQL（LangGraph checkpointer + store）
DB_URL=postgresql://postgres:postgres@localhost:5432/ecom_cs
DB_USER=postgres
DB_PASSWORD=postgres

# LangSmith 观测（可选）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_xxxxxxxx
LANGCHAIN_PROJECT=ecom-cs-prod